---
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<span
  class:list={[
    'inline-flex shrink-0 items-center justify-center rounded-pill bg-primary px-4 py-2 text-badge text-secondary uppercase',
    className,
  ]}
>
  {label}
</span>
