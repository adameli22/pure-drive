---
import { ResponsiveImage } from '~/components/ResponsiveImage';
import { SectionBadge } from '~/components/SectionBadge';

// TODO: fix image
// TODO: fix background color
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  phoneNumber?: any;
  email?: any;
  image?: { id: string; responsiveImage: any } | null;
  imageAlt?: string;
}

const { eyebrow, title, description, phoneNumber, email, image, imageAlt } = Astro.props;

const phone = phoneNumber?.formatted;
const mail = email?.formatted;

// const paragraphs = (description ?? '')
//   .split('\n')
//   .map((paragraph) => paragraph.trim())
//   .filter(Boolean);

const photo = image?.responsiveImage;
const photoData = photo ? { ...photo, alt: photo.alt ?? imageAlt } : null;

const fillImage = {
  width: '100%',
  height: '100%',
  maxWidth: 'none',
  aspectRatio: 'auto',
  objectFit: 'cover',
};
---

<div class="bg-secondary background-max-width">
  <section
    id={title.replace(/ /g, '-').toLowerCase()}
    class="bg-secondary py-14 sm:py-16 lg:py-24 xl:py-section"
  >
    <div class="flex flex-col items-center gap-10 lg:flex-row xl:gap-column">
      <div class="flex flex-1 flex-col items-start gap-8">
        {eyebrow && <SectionBadge label={eyebrow} />}
        <h2 class="text-white">{title}</h2>

        <div class="flex flex-col gap-2">
          <p class="text-inverse-muted">{description}</p>
        </div>

        <div class="flex flex-col gap-5">
          {
            phone && (
              <a href={phone.url} class="flex items-center gap-4">
                <svg class="size-12 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
                  <rect width="48" height="48" rx="12" class="fill-primary/15" />
                  <path
                    d="M16.8267 22.3867C18.7467 26.16 21.84 29.24 25.6133 31.1733L28.5467 28.24C28.9067 27.88 29.44 27.76 29.9067 27.92C31.4 28.4133 33.0133 28.68 34.6667 28.68C35.4 28.68 36 29.28 36 30.0133V34.6667C36 35.4 35.4 36 34.6667 36C22.1467 36 12 25.8533 12 13.3333C12 12.6 12.6 12 13.3333 12H18C18.7333 12 19.3333 12.6 19.3333 13.3333C19.3333 15 19.6 16.6 20.0933 18.0933C20.24 18.56 20.1333 19.08 19.76 19.4533L16.8267 22.3867Z"
                    class="fill-primary"
                  />
                </svg>
                <span class="text-title text-white underline">{phone.text}</span>
              </a>
            )
          }

          {
            mail && (
              <a href={mail.url} class="flex items-center gap-4">
                <svg class="size-12 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
                  <rect width="48" height="48" rx="12" class="fill-primary/15" />
                  <path
                    d="M35.2 13.5H12.8C11.26 13.5 10.014 14.6813 10.014 16.125L10 31.875C10 33.3188 11.26 34.5 12.8 34.5H35.2C36.74 34.5 38 33.3188 38 31.875V16.125C38 14.6813 36.74 13.5 35.2 13.5ZM35.2 31.875H12.8V18.75L24 25.3125L35.2 18.75V31.875ZM24 22.6875L12.8 16.125H35.2L24 22.6875Z"
                    class="fill-primary"
                  />
                </svg>
                <span class="text-title text-white underline">{mail.text}</span>
              </a>
            )
          }
        </div>
      </div>

      <div class="flex w-full shrink-0 items-center justify-center lg:w-[562px]">
        {
          photoData && (
            <div class="aspect-[437/583] w-full max-w-[437px] overflow-hidden rounded-card shadow-photo-accent">
              <ResponsiveImage
                data={photoData}
                sizes="(max-width: 1024px) 90vw, 437px"
                pictureClass="size-full"
                imgStyle={fillImage}
                imgClass="size-full object-cover"
              />
            </div>
          )
        }
      </div>
    </div>
  </section>
</div>
