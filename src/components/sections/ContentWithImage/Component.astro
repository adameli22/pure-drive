---
import { StructuredText } from '@datocms/astro';
import { ResponsiveImage } from '~/components/ResponsiveImage';
import { SectionBadge } from '~/components/SectionBadge';

//TODO:

interface Props {
  eyebrow: string;
  title: string;
  text: { value: any };
  highlightedTopText?: string;
  image?: { id: string; responsiveImage: any } | null;
  imagePosition?: boolean;
  imageAlt?: string;
}

const { eyebrow, title, highlightedTopText, text, image, imagePosition, imageAlt } = Astro.props;
const imgPos = imagePosition ? 'right' : 'left';

const photo = image?.responsiveImage;
const photoData = photo ? { ...photo, alt: photo.alt ?? imageAlt } : null;

const fillImage = {
  width: '100%',
  height: '100%',
  maxWidth: 'none',
  aspectRatio: 'auto',
  objectFit: 'cover',
};
---

<div class="bg-surface-warm">
  <section id={eyebrow.replace(/ /g, '-').toLowerCase()} class="py-10 lg:py-16">
    <div
      class:list={[
        'flex flex-col items-center gap-10 lg:flex-row lg:gap-24',
        imgPos == 'right' && 'lg:flex-row-reverse',
      ]}
    >
      <div class="flex shrink-0 items-center justify-center">
        {
          photoData && (
            <div class="hidden md:block size-[280px] overflow-hidden rounded-card sm:size-[380px] lg:size-[450px]">
              <ResponsiveImage
                data={photoData}
                sizes="(max-width: 640px) 280px, (max-width: 1024px) 380px, 450px"
                pictureClass="block size-full"
                imgStyle={fillImage}
                imgClass="size-full object-cover"
              />
            </div>
          )
        }
      </div>

      <div class="flex flex-1 flex-col items-start gap-6">
        {eyebrow && <SectionBadge label={eyebrow} />}
        <h2 class="text-secondary">{title}</h2>

        <div class="flex flex-col gap-6 text-muted">
          {
            highlightedTopText && (
              <p class="text-title font-semibold leading-8 text-primary">{highlightedTopText}</p>
            )
          }
          {
            photoData && (
              <div class="md:hidden xlsize-[280px] overflow-hidden rounded-card sm:size-[380px] lg:size-[450px]">
                <ResponsiveImage
                  data={photoData}
                  sizes="(max-width: 640px) 280px, (max-width: 1024px) 380px, 450px"
                  pictureClass="block size-full"
                  imgStyle={fillImage}
                  imgClass="size-full object-cover"
                />
              </div>
            )
          }
          <StructuredText data={text.value} />
        </div>
      </div>
    </div>
  </section>
</div>
