---
import { SectionBadge } from '~/components/SectionBadge';

interface Plan {
  title: string;
  description: string;
  price: string;
  highlight?: boolean;
  badge?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  plans?: Plan[];
}

const { eyebrow, title, intro, plans = [] } = Astro.props;
---

<div class="bg-surface-warm">
  <section id={eyebrow.replace(/ /g, '-').toLowerCase()} class="py-10 lg:py-16">
    <div class="flex flex-col gap-10 xl:gap-block">
      <div class="flex flex-col items-center gap-4 text-center">
        {eyebrow && <SectionBadge label={eyebrow} />}
        <h2 class="text-secondary">{title}</h2>
        {intro && <p class="max-w-[700px] text-muted">{intro}</p>}
      </div>

      <ul class="grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
        {
          plans.map((plan) => (
            <li
              class:list={[
                'flex flex-col gap-6 rounded-card border-2 border-secondary p-6 lg:p-card',
                plan.highlight ? 'bg-secondary shadow-card-featured' : 'bg-surface shadow-card',
              ]}
            >
              <div class="flex flex-col items-start gap-2">
                <h3
                  class:list={[
                    'text-title',
                    plan.highlight ? 'text-inverse-muted' : 'text-secondary',
                  ]}
                >
                  {plan.title}
                </h3>
                {(plan.badge ?? (plan.highlight ? 'Vinsælast' : null)) && (
                  <span class="inline-flex items-center justify-center rounded-chip bg-primary-soft px-2.5 py-1 text-badge text-primary">
                    {plan.badge ?? 'Vinsælast'}
                  </span>
                )}
              </div>

              <p
                class:list={[
                  'flex-1 text-caption',
                  plan.highlight ? 'text-inverse-muted' : 'text-muted',
                ]}
              >
                {plan.description}
              </p>

              <p class:list={['pt-5 text-price', plan.highlight ? 'text-white' : 'text-text']}>
                {plan.price}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</div>
