---
import '~/styles/global.css';
import { TagFragment } from '~/lib/datocms/commonFragments';
import { executeQuery } from '~/lib/datocms/executeQuery';
import { graphql } from '~/lib/datocms/graphql';
import { Header } from '~/components/Header';
import { Footer } from '~/components/Footer';
import { HeaderFragment } from '~/components/Header/fragments';
import { FooterFragment } from '~/components/Footer/fragments';
import { Seo, type TitleMetaLinkTag } from '@datocms/astro';
type Props = {
  additionalSeo?: TitleMetaLinkTag[];
};

const { additionalSeo = [] } = Astro.props;

const query = graphql(
  /* GraphQL */ `
    query RootQuery {
      _site {
        faviconMetaTags {
          ...TagFragment
        }
      }
      header {
        ...HeaderFragment
      }
      footer {
        ...FooterFragment
      }
    }
  `,
  [TagFragment, HeaderFragment, FooterFragment],
);

const result = await executeQuery(query);
---

<!doctype html>
<html lang="is" class="text-(color:--color-text) font-primary font-normal">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <Seo data={[...result._site.faviconMetaTags, ...additionalSeo]} />
  </head>
  <body>
    <Header data={result.header} />
    <main>
      <slot />
    </main>
    <Footer data={result.footer} />
  </body>
</html>
